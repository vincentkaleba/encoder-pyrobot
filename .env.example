# Basic bot config — copy to .env and fill the values
BOT_TOKEN=
API_ID=
API_HASH=

# Session string (optional)
SESSION_STRING=
SESSION=
USERBOT_ENABLED=true

# MongoDB (if using the compose setup below, use the provided URI)
# Example for the local compose Mongo: mongodb://mongo:mongo@mongo:27017/
MONGODB_URI=mongodb://mongo:mongo@mongo:27017/

# Directories (absolute or relative to project root)
DOWNLOAD_DIR=./download
ENCODE_DIR=./encode
DRIVE_DIR=
INDEX_URI=

# Owner / permissions
OWNER_ID=
SUDO_USERS=
AUTHORIZED_CHATS=

# Logging
LOG_DIR=./logs
LOG_CHANNELS=
DUMP_CHAT=
LOG_LEVEL=INFO
LOG_FILE=

# Telegram upload settings
TG_SPLIT_SIZE=2
AS_DOCUMENT=false
FILE_BASE_NAME=false
BASE_NAME=

# Misc
ISOCODE_VERSION=1.0.0
ISO_CODE=fr

# NOTE: after copying to `.env`, set BOT_TOKEN, API_ID, API_HASH and OWNER_ID at minimum.
